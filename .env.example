# ---- required ----
DATABASE_URL=postgres://hiklean:CHANGE_ME@localhost:5432/hiklean
# generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# ---- first run only: creates the first admin login ----
ADMIN_USER=admin
ADMIN_PASSWORD=            # set one; you will be forced to change it at first login

# ---- optional ----
PORT=3000
NODE_ENV=production
SESSION_HOURS=12
PGSSL=false            # true for managed Postgres (Render, Neon, Supabase, RDS)
PGSSLROOTCERT=         # path to the provider's CA file — certificates ARE verified
TRUST_PROXY=false      # true ONLY when nginx/Caddy sits in front (else the rate limit can be spoofed)
TZ=Asia/Kolkata
START_BILL_NO=168      # next bill printed will be 169
START_REG_NO=12681     # next patient ID will be 12682
